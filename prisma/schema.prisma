generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  // Apodo opcional que el usuario elige para sí mismo (ver
  // /mi-perfil/configuracion) -a diferencia de Regatista.nombre (el
  // nombre "oficial" tal como viene de los resultados importados de una
  // regata), este es de uso puramente personal/de cuenta y no aparece en
  // ningún resultado ni tabla de posiciones.
  apodo         String?
  passwordHash  String?
  image         String?
  role          Role      @default(REGULAR)
  regatista     Regatista? @relation(fields: [regatistaId], references: [id])
  regatistaId   String?   @unique
  emailVerified DateTime?
  // Cuándo aceptó el Aviso Legal y la Política de Privacidad al
  // registrarse -null para cuentas creadas antes de que existiera el
  // checkbox (ver src/app/registro/page.tsx). Guardar el momento, no solo
  // un booleano, deja registro de que hubo un consentimiento real en vez
  // de un valor que cualquiera pudo haber seteado en true sin haber
  // aceptado nada.
  aceptoTerminosEn DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  solicitudes   SolicitudVinculacion[]
}

enum Role {
  ADMIN
  // Acceso total a la creación/edición de campeonatos (regatas,
  // resultados, importar CSV, publicar) -pensado para la persona del
  // club que organiza una regata puntual y carga sus resultados, sin
  // darle acceso a lo que sí es exclusivo de ADMIN (gestión de
  // regatistas, clubes, solicitudes de vinculación, errores del sistema,
  // ni la posibilidad de asignar roles a otros usuarios).
  ORGANIZADOR
  REGULAR
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Regatista {
  id              String      @id @default(cuid())
  nombre          String
  club            Club?       @relation(fields: [clubId], references: [id])
  clubId          String?
  // Regatistas que compiten por dos clubes (ej: "YCA / CNMP"): `club` es el
  // principal y acá van los demás -así cada club reconocido lo cuenta como
  // suyo en vez de quedar en un club "combo" inventado.
  otrosClubes     Club[]      @relation("OtrosClubes")
  pais            String?     @default("Argentina")
  fechaNacimiento DateTime?
  fuenteIds       Json?       // { "sailwave": "PEREZ Juan", "fay": "123" }
  // Foto de perfil opcional que el regatista (una vez vinculado a su
  // cuenta) puede subir desde /mi-perfil/configuracion -se muestra en su
  // ficha pública (/regatistas/[id]) en vez de las iniciales genéricas.
  fotoUrl         String?
  user            User?
  resultados      Resultado[]
  solicitudes     SolicitudVinculacion[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([nombre])
  // La ficha de un club (ver /clubes/[id]) filtra "todos los resultados de
  // los regatistas con este clubId" -sin este índice, esa consulta
  // escaneaba la tabla Regatista entera para encontrar quiénes son del
  // club antes de poder ir a buscar sus resultados.
  @@index([clubId])
}

model Club {
  id          String       @id @default(cuid())
  nombre      String       @unique
  ciudad      String?
  // Nombre completo (el `nombre` suele ser la sigla, ej: "YCA"), editable
  // desde /admin/clubes/escudos.
  nombreCompleto String?
  // Escudo del club, cargado a mano por un admin desde /admin/clubes -si es
  // null se sigue mostrando el ClubAvatar genérico (iniciales + color).
  logoUrl     String?
  regatistas  Regatista[]
  regatistasSecundarios Regatista[] @relation("OtrosClubes")
  campeonatos Campeonato[]
}

model Clase {
  id          String       @id @default(cuid())
  nombre      String       @unique
  campeonatos Campeonato[]
}

model Campeonato {
  id          String             @id @default(cuid())
  nombre      String
  anio        Int
  clase       Clase              @relation(fields: [claseId], references: [id])
  claseId     String
  sede        Club?              @relation(fields: [sedeId], references: [id])
  sedeId      String?
  fechaInicio DateTime?
  fechaFin    DateTime?
  fuenteUrl   String?
  estado      EstadoCampeonato   @default(BORRADOR)
  descartes   Int                @default(0)
  regatas     Regata[]
  staging     StagingImport[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([anio])
  @@index([claseId])
}

enum EstadoCampeonato {
  BORRADOR
  PUBLICADO
}

model Regata {
  id            String      @id @default(cuid())
  campeonato    Campeonato  @relation(fields: [campeonatoId], references: [id], onDelete: Cascade)
  campeonatoId  String
  numero        Int
  fecha         DateTime?
  condiciones   String?
  resultados    Resultado[]

  @@unique([campeonatoId, numero])
}

model Resultado {
  id           String    @id @default(cuid())
  regata       Regata    @relation(fields: [regataId], references: [id], onDelete: Cascade)
  regataId     String
  regatista    Regatista @relation(fields: [regatistaId], references: [id])
  regatistaId  String
  puesto       Int
  puntos       Float
  descartado   Boolean   @default(false)
  observacion  String?
  // Nombre de la flota/split (Gold/Silver/Bronze, etc.) en la que compitió
  // este regatista, cuando el campeonato divide la flota por nivel. En la
  // clasificación combinada, TODA una flota va antes que la siguiente, sin
  // importar el puntaje (se solapan los rangos de puntos entre flotas) -
  // flotaOrden guarda ese orden (0 = la mejor), tomado del orden en que
  // aparece cada flota en el archivo importado.
  flota        String?
  flotaOrden   Int?
  // Puesto y puntos totales YA calculados por la fuente (columnas "puesto"
  // y "Total puntos" del Excel), para cuando queremos mostrar exactamente
  // eso -sin que la app recalcule descartes, desempates u orden de flota-
  // en vez de reconstruir la clasificación a partir de las regatas. Cuando
  // están presentes para todos los regatistas de un campeonato, mandan por
  // sobre el cálculo propio (ver generarClasificacion en scoring.ts).
  puestoOficial Int?
  totalOficial  Float?
  // Columnas "personalizadas" que el admin eligió conservar al importar
  // (ej: "Categoría", "DNI", "Edad") pero que no son ninguno de los campos
  // fijos de arriba -guardadas tal cual como {nombreDeColumna: valor}, para
  // mostrarlas como columnas extra en la tabla de posiciones sin tener que
  // agregar una columna nueva a la base por cada campeonato distinto.
  datosExtra    Json?

  @@unique([regataId, regatistaId])
  @@index([regatistaId])
}

model StagingImport {
  id            String        @id @default(cuid())
  campeonato    Campeonato?   @relation(fields: [campeonatoId], references: [id])
  campeonatoId  String?
  datosCrudos   Json
  estado        EstadoStaging @default(PENDIENTE)
  fuente        String?
  notas         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum EstadoStaging {
  PENDIENTE
  APROBADO
  RECHAZADO
}

model SolicitudVinculacion {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  regatista   Regatista @relation(fields: [regatistaId], references: [id], onDelete: Cascade)
  regatistaId String
  estado      EstadoSolicitud @default(PENDIENTE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, regatistaId])
}

enum EstadoSolicitud {
  PENDIENTE
  APROBADA
  RECHAZADA
}

// Monitoreo de errores casero: sin un servicio externo (Sentry, etc. -
// necesitarían una cuenta y un DSN que no tenemos), handleApiError()
// escribe acá cualquier error no esperado de una API route además de
// mandarlo a console.error como ya hacía. /admin/errores lo lista, así
// hay una forma real de enterarse de que algo rompió en producción sin
// depender de que un usuario escriba para avisar.
model ErrorLog {
  id        String   @id @default(cuid())
  contexto  String
  mensaje   String
  stack     String?  @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Rate limiting compartido entre instancias (ver src/lib/rate-limit.ts):
// el límite anterior vivía en un Map en memoria, que en un entorno
// serverless (Vercel) no se comparte entre instancias -dos requests que
// caían en instancias distintas no veían el intento la una de la otra.
// Guardarlo acá (mismo Postgres que ya usa toda la app) lo hace
// consistente sin depender de un servicio de cache aparte (Redis/Upstash).
model RateLimitEntry {
  clave         String   @id
  intentos      Int      @default(1)
  ventanaInicio DateTime @default(now())
}

// Registro de auditoría de acciones administrativas sensibles (cambiar el
// rol de un usuario, publicar/eliminar un campeonato, etc.) -antes no
// quedaba ningún rastro de quién hizo qué, algo relevante ahora que hay
// varios ADMIN/ORGANIZADOR con permisos de edición reales. Guarda el
// email del actor en texto plano (no una relación a User) para que el
// registro siga siendo legible aunque esa cuenta se elimine después.
model AuditLog {
  id          String   @id @default(cuid())
  actorEmail  String
  actorNombre String?
  accion      String
  entidad     String
  entidadId   String?
  detalle     Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([entidad, entidadId])
}

// Mensajes del formulario de /contacto -no hay una dirección de mail
// "oficial" de FAY configurada como variable de entorno, así que en vez de
// depender de un envío de mail que podría fallar silenciosamente, el
// mensaje queda guardado acá (y /admin/mensajes lo lista) además de
// intentar notificar por mail a los ADMIN si RESEND_API_KEY está
// configurada.
model MensajeContacto {
  id        String   @id @default(cuid())
  nombre    String
  email     String
  asunto    String
  mensaje   String   @db.Text
  leido     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

